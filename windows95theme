}

.resize_nw,
.resize_ne,
.resize_sw,
.resize_se,
.resize_n,
.resize_w,
.resize_s,
.resize_e {
    position: absolute;
    user-select: none;
}

.resize_nw {
    cursor: nwse-resize;
    width: 8px;
    height: 8px;
    top: -4px;
    left: -4px;
}

.resize_ne {
    cursor: nesw-resize;
    width: 8px;
    height: 8px;
    top: -4px;
    right: -4px;
}

.resize_sw {
    cursor: nesw-resize;
    width: 8px;
    height: 8px;
    bottom: -4px;
    left: -4px;
}

.resize_se {
    cursor: nwse-resize;
    width: 8px;
    height: 8px;
    bottom: -4px;
    right: -4px;
}

.resize_n {
    cursor: ns-resize;
    height: 8px;
    top: -4px;
    inset-inline: 4px;
}

.resize_w {
    cursor: ew-resize;
    width: 8px;
    left: -4px;
    inset-block: 4px;
}

.resize_s {
    cursor: ns-resize;
    height: 8px;
    bottom: -4px;
    inset-inline: 4px;
}

.resize_e {
    cursor: ew-resize;
    width: 8px;
    right: -4px;
    inset-block: 4px;
}

