#start_menu{
        border-image: none;
        background: linear-gradient(0deg, var(--dimwhenstartmenu), var(--dimwhenstartmenu))/*, var(--wp)*/;
        background-position: center;
        background-size: cover;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%
}
#start_menu_body {
	position: absolute;
        border-top: 1px solid #6699FF;
	top: 70px;
	left: 0px;
	padding-top: 15px;
        padding-left: 15px;
        padding-right: 15px;
        width: 100%;
        height: 100%;
	background: none;
	display: flex;
        flex-wrap: wrap;
	flex-direction: row;
	gap: 4px;
}

.start_menu_item_details {
        display: none;
}

.start_menu_item:hover{
        background: none;
}

.start_menu_item {
	display: flex;
	flex-direction: row;
	gap: 8px;
	height: 3em;
	padding: 10px;
        /* left: calc(50% - 110px); */
        left: 0px;
        top: 0px;
        position: relative;
	gap: 6px;
	cursor: pointer;
}

#start_menu_pfp{
        width: 50px;
        height: 50px;
        border: 0px solid transparent;
        border-radius: 0px;
        background-size: 0%;
        background-color: transparent;
        content: url("https://file.garden/alBgarnuWEQGoy5b/Untitled402_20261029160456.png");
}

#start_menu_vault {
	position: absolute;
	bottom: 0px;
        top: -14px;
	right: -12px;
	width: 100px;
	height: 100px;
	background: url("https://file.garden/alBgarnuWEQGoy5b/unlock_halo.png");
        background-position: center;
        background-size: 80%;
        background-repeat: no-repeat;
	cursor: pointer;
}
#start_menu_vault::before{
        content: "";
        display: inline-block;
        width: 100px;
        height: 100px;
filter: drop-shadow(0px 0px 2px white);
        background: url("https://file.garden/alBgarnuWEQGoy5b/Untitled403_20261029162342.png");
        background-position: center;
        background-size: 50%;
        background-repeat: no-repeat;
}

.vault-body {
	flex: 1;
	background: black;
	position: relative;
}

.vault-message {
	position: absolute;
	height: 60px;
	top: 20px;
	inset-inline: 20px;
	display: flex;
	text-align: center;
	justify-content: center;
	align-items: center;
	font: 20px "Droid Sans";
	color: white;
	line-height: 0.7;
	-webkit-text-stroke: 0px black;
	text-shadow: #000000CC 2px 2px 2px;
}

.vault-input {
	box-sizing: border-box;
	position: absolute;
	padding: 20px;
	font: 20px "Droid Sans";
	color: white;
	top: 100px;
	left: calc(50% - 450px / 2);
	width: 450px;
	border: none;
	border-radius: 5px;
	background: #000000;
	outline: 1px solid #6699FF20;
        filter: drop-shadow(0px 0px 16px var(--honeyholo));
	text-align: center;
	-webkit-text-stroke: 0px black;
	text-shadow: #000000CC 2px 2px 2px;
}

.poll-title {
